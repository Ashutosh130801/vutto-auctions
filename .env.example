# ---------------------------------------------------------------------------
# Vutto Auctions — environment template.  Copy to `.env` and edit.
# Every value below is safe for local development ONLY.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
PORT=8000                           # hosted platforms inject this
WEB_CONCURRENCY=1                   # uvicorn workers; 1 is right on a shared CPU
LOG_LEVEL=INFO
LOG_FORMAT=console                  # console | json  (use json in prod)

# --- Security ---------------------------------------------------------------
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900        # 15 min
REFRESH_TOKEN_TTL_SECONDS=2592000   # 30 days
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# --- Datastores -------------------------------------------------------------
# Paste a hosted connection string exactly as your provider gives it — the
# libpq `sslmode` / `channel_binding` parameters used by Neon, Supabase and
# Render are translated per-driver in app/core/dburl.py.  Nothing to hand-edit.
#   Neon: postgresql://user:pw@ep-x-pooler.region.aws.neon.tech/db?sslmode=require&channel_binding=require
DATABASE_URL=postgresql+asyncpg://vutto:vutto@postgres:5432/vutto
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
REDIS_URL=redis://redis:6379/0

# --- Auction engine defaults -------------------------------------------------
ANTI_SNIPE_WINDOW_SECONDS=120       # bid inside this window extends the auction
ANTI_SNIPE_EXTENSION_SECONDS=120    # by this much
ANTI_SNIPE_MAX_EXTENSIONS=20        # hard cap so an auction cannot run forever
AUCTION_TICK_SECONDS=1              # lifecycle scheduler cadence
OUTBOX_RELAY_BATCH=200

# --- Rate limits (token bucket, Redis backed) --------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BID_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=300

# --- Observability -----------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=vutto-api
METRICS_ENABLED=true

# --- Workers -----------------------------------------------------------------
# true  = the API process also runs the auction scheduler and outbox relay.
#         Correct for a single-container deployment (a free tier, say).
# false = a dedicated worker container owns them.  Correct in production.
RUN_BACKGROUND_WORKERS=true
SEED_ON_START=true                  # entrypoint seeds demo data; no-op if users exist
TRUST_PROXY_HEADERS=false           # true ONLY behind your own reverse proxy

# --- Seed data ---------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@vutto.example.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_PASSWORD=Demo@12345

# --- Frontend (build-time) ---------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
